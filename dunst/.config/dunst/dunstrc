[global]
    font = Sans 11
    allow_markup = yes
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_missing = yes
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    geometry = "350x5-15+15"
    transparency = 0
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    history_length = 20
    show_indicators = yes

    # Esquinas y bordes
    corner_radius = 4
    frame_width = 2
    frame_color = "#89b4fa"
    separator_color = frame

    # Padding e iconos
    padding = 18
    horizontal_padding = 18
    icon_position = left
    max_icon_size = 48

[urgency_low]
    background = "#181825"
    foreground = "#cdd6f4"
    timeout = 5

[urgency_normal]
    background = "#181825"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 7

[urgency_critical]
    background = "#181825"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    timeout = 0
