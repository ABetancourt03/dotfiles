[
  {
    "plugin_id": "ntindle.herdr-resurrect",
    "name": "herdr-resurrect",
    "version": "0.2.0",
    "min_herdr_version": "0.7.0",
    "description": "tmux-resurrect for herdr: snapshot the whole herd (workspaces, tabs, panes, cwd, running programs, agents) and bring it back after a crash or reboot.",
    "manifest_path": "/home/btw/.config/herdr/plugins/github/ntindle.herdr-resurrect-6e4571261caf/herdr-plugin.toml",
    "plugin_root": "/home/btw/.config/herdr/plugins/github/ntindle.herdr-resurrect-6e4571261caf",
    "enabled": true,
    "platforms": [
      "linux",
      "macos",
      "windows"
    ],
    "actions": [
      {
        "id": "restore",
        "title": "Resurrect: restore last snapshot",
        "contexts": [
          "workspace"
        ],
        "command": [
          "node",
          "bin/restore.js"
        ]
      },
      {
        "id": "restore-preview",
        "title": "Resurrect: preview restore (dry run)",
        "contexts": [
          "workspace"
        ],
        "command": [
          "node",
          "bin/restore.js",
          "--dry-run"
        ]
      },
      {
        "id": "save",
        "title": "Resurrect: save snapshot",
        "contexts": [
          "workspace"
        ],
        "command": [
          "node",
          "bin/save.js"
        ]
      },
      {
        "id": "snapshots",
        "title": "Resurrect: list snapshots",
        "contexts": [
          "workspace"
        ],
        "command": [
          "node",
          "bin/list.js"
        ]
      }
    ],
    "events": [
      {
        "on": "pane.agent_detected",
        "command": [
          "node",
          "bin/on-event.js"
        ]
      },
      {
        "on": "pane.closed",
        "command": [
          "node",
          "bin/on-event.js"
        ]
      },
      {
        "on": "pane.created",
        "command": [
          "node",
          "bin/on-event.js"
        ]
      },
      {
        "on": "pane.exited",
        "command": [
          "node",
          "bin/on-event.js"
        ]
      },
      {
        "on": "workspace.closed",
        "command": [
          "node",
          "bin/on-event.js"
        ]
      },
      {
        "on": "workspace.created",
        "command": [
          "node",
          "bin/on-event.js"
        ]
      }
    ],
    "panes": [
      {
        "id": "autosave",
        "title": "resurrect autosave",
        "placement": "split",
        "command": [
          "node",
          "bin/autosave.js"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  }
]